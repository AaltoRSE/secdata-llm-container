Bootstrap: docker
From: nvidia/cuda:12.9.0-cudnn-devel-ubuntu22.04

%labels
  Author Yu Tian
  Container for running open-source LLMs with GPU support

%files
  env.yml /opt/env.yml
  nltk_data /opt/nltk_data
  
# -------------------------------------------------------------------------
# Install system packages and Python libraries
%post
  # Install system packages
  apt-get update && apt-get install -y --no-install-recommends \
    build-essential git \
    python3-dev python3-pip \
    curl ca-certificates \
    libssl-dev libffi-dev \
    neovim nano less htop ripgrep \
    libopenblas-dev libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*

  # Install Miniforge with error checking
  MINIFORGE_URL="https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh"
  if ! curl -L -o /tmp/miniforge.sh $MINIFORGE_URL; then
    echo "Failed to download Miniforge" >&2
    exit 1
  fi
  bash /tmp/miniforge.sh -b -p /opt/conda
  rm /tmp/miniforge.sh

  # Add conda to PATH and initialize
  export PATH="/opt/conda/bin:$PATH"

  echo "source /opt/conda/etc/profile.d/conda.sh" >> /etc/bash.bashrc
  echo "conda activate sec-llm-env" >> /etc/bash.bashrc

  # Create environment and activate it
  conda env create -f /opt/env.yml 

  # Cleanup
  conda clean -a -y
  apt-get clean
  rm /opt/env.yml

  # Create Label Studio startup script
  mkdir -p /opt/label-studio
  cat << 'EOF' > /opt/label-studio/start_label_studio.sh
#!/bin/bash
# For Singularity, use a bind-mounted directory for writable data
export LABEL_STUDIO_BASE_DATA_DIR=${LABEL_STUDIO_BASE_DATA_DIR:-/label_studio_data}
mkdir -p $LABEL_STUDIO_BASE_DATA_DIR
label-studio start --data-dir $LABEL_STUDIO_BASE_DATA_DIR --no-browser
EOF
  chmod +x /opt/label-studio/start_label_studio.sh

# -------------------------------------------------------------------------
# Environment variables set on container start
%environment
  # Add conda env bin first so its Python/packages take priority
  export PATH="/opt/conda/envs/sec-llm-env/bin:/opt/conda/bin:/usr/local/bin:$PATH"
  export CONDA_PREFIX=/opt/conda/envs/sec-llm-env
  export CONDA_DEFAULT_ENV=sec-llm-env
  export LD_LIBRARY_PATH=/opt/conda/envs/sec-llm-env/lib:/usr/local/cuda/lib64:$LD_LIBRARY_PATH
  export CUDA_HOME=/usr/local/cuda
  export TRANSFORMERS_OFFLINE=1
  export HF_DATASETS_OFFLINE=1
  export HF_HUB_OFFLINE=1
  export HF_HOME=/models/huggingface-hub
  export NLTK_DATA=/opt/nltk_data
  export PYTHONUNBUFFERED=1
  
# -------------------------------------------------------------------------
# Run script
%runscript
  exec python "$@"



