Bootstrap: docker
From: nvidia/cuda:12.9.0-cudnn-devel-ubuntu22.04

%labels
  Author Yu Tian
  Container for running open-source LLMs with GPU support
  CondaEnvDefault sec-llm-env
  CondaEnvAlt sec-llm-env2
  CondaEnvThird sec-llm-env3

%files
  env.yml /opt/env.yml
  env2.yml /opt/env2.yml
  env3.yml /opt/env3.yml
  nltk_data /opt/nltk_data
  container-scripts/start_ollama.sh /opt/dev/start_ollama.sh
  container-scripts/start_jupyter_lab.sh /opt/dev/start_jupyter_lab.sh
  container-scripts/start_code_server.sh /opt/dev/start_code_server.sh
  container-scripts/continue-config.yaml /opt/dev/continue-config.yaml

# -------------------------------------------------------------------------
# Install system packages and Python libraries
%post
  # Pinned third-party versions (bump when rebuilding with network; VDI runtime is offline).
  CODE_SERVER_VER=4.112.0
  CONTINUE_VSIX_URL="https://open-vsx.org/api/Continue/continue/linux-x64/1.3.33/file/Continue.continue-1.3.33@linux-x64.vsix"
  # VS Code extensions (VSIX) pinned + downloaded at build time for offline VDI runtime.
  PYTHON_VSIX_URL="https://open-vsx.org/api/ms-python/python/2026.4.0/file/ms-python.python-2026.4.0.vsix"
  JUPYTER_VSIX_URL="https://open-vsx.org/api/ms-toolsai/jupyter/2025.9.1/file/ms-toolsai.jupyter-2025.9.1.vsix"
  # Helpers / bundles used by Python + Jupyter extensions.
  DEBUGPY_VSIX_URL="https://open-vsx.org/api/ms-python/debugpy/linux-x64/2025.18.0/file/ms-python.debugpy-2025.18.0@linux-x64.vsix"
  PYTHON_ENVS_VSIX_URL="https://open-vsx.org/api/ms-python/vscode-python-envs/1.24.0/file/ms-python.vscode-python-envs-1.24.0.vsix"
  JUPYTER_KEYMAP_VSIX_URL="https://open-vsx.org/api/ms-toolsai/jupyter-keymap/1.1.2/file/ms-toolsai.jupyter-keymap-1.1.2.vsix"
  JUPYTER_RENDERERS_VSIX_URL="https://open-vsx.org/api/ms-toolsai/jupyter-renderers/1.3.0/file/ms-toolsai.jupyter-renderers-1.3.0.vsix"
  JUPYTER_SLIDESHOW_VSIX_URL="https://open-vsx.org/api/ms-toolsai/vscode-jupyter-slideshow/0.1.6/file/ms-toolsai.vscode-jupyter-slideshow-0.1.6.vsix"
  JUPYTER_CELL_TAGS_VSIX_URL="https://open-vsx.org/api/ms-toolsai/vscode-jupyter-cell-tags/0.1.9/file/ms-toolsai.vscode-jupyter-cell-tags-0.1.9.vsix"
  OLLAMA_VER=0.18.2

  # Install system packages
  apt-get update && apt-get install -y --no-install-recommends \
    build-essential git \
    python3-dev python3-pip \
    curl ca-certificates \
    libssl-dev libffi-dev \
    neovim nano less htop ripgrep \
    libopenblas-dev libopenmpi-dev \
    zstd \
    && rm -rf /var/lib/apt/lists/*

  # Install Miniforge with error checking
  MINIFORGE_URL="https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh"
  if ! curl -L -o /tmp/miniforge.sh $MINIFORGE_URL; then
    echo "Failed to download Miniforge" >&2
    exit 1
  fi
  bash /tmp/miniforge.sh -b -p /opt/conda
  rm /tmp/miniforge.sh

  export PATH="/opt/conda/bin:$PATH"
  echo "source /opt/conda/etc/profile.d/conda.sh" >> /etc/bash.bashrc
  echo "conda activate sec-llm-env" >> /etc/bash.bashrc

  # Building containers often happens without a visible GPU, but CUDA-enabled PyTorch
  # packages depend on the `__cuda` virtual package. Override detection so the solver
  # can resolve GPU PyTorch at build time.
  export CONDA_OVERRIDE_CUDA=12.4

  conda env create -f /opt/env.yml

  # Second isolated env (Python 3.10 + PyTorch CUDA 11.8 stack from env2.yml).
  export CONDA_OVERRIDE_CUDA=11.8
  conda env create -f /opt/env2.yml

  # Third isolated env (Python 3.11 + PyTorch CUDA 12.4 stack from env3.yml).
  export CONDA_OVERRIDE_CUDA=12.4
  conda env create -f /opt/env3.yml
  unset CONDA_OVERRIDE_CUDA

  conda clean -a -y
  apt-get clean
  rm -f /opt/env.yml /opt/env2.yml /opt/env3.yml

  # Create Label Studio startup script
  mkdir -p /opt/label-studio
  cat << 'EOF' > /opt/label-studio/start_label_studio.sh
#!/bin/bash
# For Singularity, use a bind-mounted directory for writable data
export LABEL_STUDIO_BASE_DATA_DIR=${LABEL_STUDIO_BASE_DATA_DIR:-/label_studio_data}
mkdir -p $LABEL_STUDIO_BASE_DATA_DIR
label-studio start --data-dir $LABEL_STUDIO_BASE_DATA_DIR --no-browser
EOF
  chmod +x /opt/label-studio/start_label_studio.sh

  # code-server (VS Code in browser); extensions baked in for offline VDI use
  curl -fL -o /tmp/code-server.tgz \
    "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VER}/code-server-${CODE_SERVER_VER}-linux-amd64.tar.gz"
  tar -C /opt -xzf /tmp/code-server.tgz
  rm /tmp/code-server.tgz
  mv "/opt/code-server-${CODE_SERVER_VER}-linux-amd64" /opt/code-server
  mkdir -p /opt/code-server/extensions
  # Install extensions at build time so runtime can be offline.
  curl -fL -o /tmp/continue.vsix "${CONTINUE_VSIX_URL}"
  curl -fL -o /tmp/python.vsix "${PYTHON_VSIX_URL}"
  curl -fL -o /tmp/jupyter.vsix "${JUPYTER_VSIX_URL}"
  curl -fL -o /tmp/debugpy.vsix "${DEBUGPY_VSIX_URL}"
  curl -fL -o /tmp/python-envs.vsix "${PYTHON_ENVS_VSIX_URL}"
  curl -fL -o /tmp/jupyter-keymap.vsix "${JUPYTER_KEYMAP_VSIX_URL}"
  curl -fL -o /tmp/jupyter-renderers.vsix "${JUPYTER_RENDERERS_VSIX_URL}"
  curl -fL -o /tmp/jupyter-slideshow.vsix "${JUPYTER_SLIDESHOW_VSIX_URL}"
  curl -fL -o /tmp/jupyter-cell-tags.vsix "${JUPYTER_CELL_TAGS_VSIX_URL}"
  /opt/code-server/bin/code-server \
    --extensions-dir /opt/code-server/extensions \
    --install-extension /tmp/continue.vsix \
    --install-extension /tmp/python.vsix \
    --install-extension /tmp/jupyter.vsix \
    --install-extension /tmp/debugpy.vsix \
    --install-extension /tmp/python-envs.vsix \
    --install-extension /tmp/jupyter-keymap.vsix \
    --install-extension /tmp/jupyter-renderers.vsix \
    --install-extension /tmp/jupyter-slideshow.vsix \
    --install-extension /tmp/jupyter-cell-tags.vsix
  rm -f /tmp/continue.vsix /tmp/python.vsix /tmp/jupyter.vsix /tmp/debugpy.vsix /tmp/python-envs.vsix \
    /tmp/jupyter-keymap.vsix /tmp/jupyter-renderers.vsix /tmp/jupyter-slideshow.vsix /tmp/jupyter-cell-tags.vsix
  ln -sf /opt/code-server/bin/code-server /usr/local/bin/code-server

  # Ollama (local LLM runtime for Continue and CLI)
  curl -fL -o /tmp/ollama-linux-amd64.tar.zst \
    "https://github.com/ollama/ollama/releases/download/v${OLLAMA_VER}/ollama-linux-amd64.tar.zst"
  mkdir -p /opt/ollama
  zstd -dc /tmp/ollama-linux-amd64.tar.zst | tar -x -C /opt/ollama
  rm /tmp/ollama-linux-amd64.tar.zst
  ln -sf /opt/ollama/bin/ollama /usr/local/bin/ollama

  chmod +x /opt/dev/start_ollama.sh /opt/dev/start_jupyter_lab.sh /opt/dev/start_code_server.sh

# -------------------------------------------------------------------------
# Environment variables set on container start
%environment
  # Add conda env bin first so its Python/packages take priority
  export PATH="/opt/conda/envs/sec-llm-env/bin:/opt/conda/bin:/usr/local/bin:$PATH"
  export CONDA_PREFIX=/opt/conda/envs/sec-llm-env
  export CONDA_DEFAULT_ENV=sec-llm-env
  export LD_LIBRARY_PATH=/opt/conda/envs/sec-llm-env/lib:/opt/ollama/lib/ollama:/opt/ollama/lib/ollama/cuda_v12:/usr/local/cuda/lib64:$LD_LIBRARY_PATH
  export OLLAMA_HOST=127.0.0.1:11434
  export OLLAMA_MODELS=/ollama_models
  export CUDA_HOME=/usr/local/cuda
  export TRANSFORMERS_OFFLINE=1
  export HF_DATASETS_OFFLINE=1
  export HF_HUB_OFFLINE=1
  export HF_HOME=/models/huggingface-hub
  export NLTK_DATA=/opt/nltk_data
  export PYTHONUNBUFFERED=1
  
# -------------------------------------------------------------------------
# Run script
%runscript
  exec python "$@"



